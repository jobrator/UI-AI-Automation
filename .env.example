# ─── Jobrator Site ────────────────────────────────────────────────────────────
JOBRATOR_SITE=https://jobrator.com/

# ─── Candidate Credentials ────────────────────────────────────────────────────
CANDIDATE_EMAIL=your_candidate_email@example.com
CANDIDATE_PASSWORD=YourPassword

# ─── Browser Settings ─────────────────────────────────────────────────────────
BROWSER=chromium
HEADLESS=true
SLOW_MO=0

# ─── Timeouts (ms) ────────────────────────────────────────────────────────────
DEFAULT_TIMEOUT=30000
NAVIGATION_TIMEOUT=60000
EXPECT_TIMEOUT=10000

# ─── Retry Settings ───────────────────────────────────────────────────────────
MAX_RETRIES=2
RETRY_DELAY=1000

# ─── Reporting ────────────────────────────────────────────────────────────────
REPORT_DIR=reports
SCREENSHOT_ON_FAILURE=true
VIDEO_ON_FAILURE=true
TRACE_ON_FAILURE=true

# ─── AI Agents ────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key_here
AGENT_MODEL=claude-sonnet-4-20250514
AGENT_MAX_TOKENS=8000

# ─── Mobile (Appium) ──────────────────────────────────────────────────────────
# Platform under test: Android | iOS
MOBILE_PLATFORM=Android

# Appium server
APPIUM_HOST=127.0.0.1
APPIUM_PORT=4723
APPIUM_PATH=/
APPIUM_LOG_LEVEL=error

# Device / emulator
MOBILE_DEVICE_NAME=Android Emulator
MOBILE_PLATFORM_VERSION=
MOBILE_UDID=

# App under test — EITHER a binary path...
MOBILE_APP_PATH=
# ...OR an already-installed build (Android)
ANDROID_APP_PACKAGE=
ANDROID_APP_ACTIVITY=
# ...OR an already-installed build (iOS)
IOS_BUNDLE_ID=

# Session behaviour
MOBILE_NO_RESET=false
MOBILE_FULL_RESET=false
MOBILE_NEW_COMMAND_TIMEOUT=240
MOBILE_DEFAULT_TIMEOUT=20000
MOBILE_STEP_TIMEOUT=120000
MOBILE_PARALLEL=1
MOBILE_TAGS=

# CV fixture pushed to the device for the CV-upload scenarios
# adb push test-data/cv/tc051-valid-cv.pdf /sdcard/Download/tc051-valid-cv.pdf
MOBILE_CV_DEVICE_PATH=/sdcard/Download/tc051-valid-cv.pdf
MOBILE_CV_DISPLAY_NAME=tc051-valid-cv
